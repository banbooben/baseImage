# 复制为同目录下的 .env（已被 .gitignore 忽略），再按需修改
#   cp .env.example .env && chmod 600 .env

# 宿主机用户 uid/gid，建议填 `id -u` / `id -g` 的结果，
# 与 workspace / apifox-data 的属主保持一致
PUID=1000
PGID=1000

# 监听地址：127.0.0.1 仅本机可访问；需要局域网访问时改成 0.0.0.0
BIND_ADDR=127.0.0.1

RESOLUTION=1920x1080
TZ=Asia/Shanghai

# 可切换为 openEuler 变体
# APIFOX_IMAGE=registry.cn-hangzhou.aliyuncs.com/sarmn/software:openeuler-24.03-apifox

# VNC 密码：不设置时使用镜像默认密码 Sam.5H8g。
# 默认密码是公开值，生产环境请取消注释并改成自己的密码；
# 设置了 VNC_PASSWORD 时必须以镜像内的 15-vnc-password 支持为准（重建后的镜像）。
# VNC_PASSWORD=
