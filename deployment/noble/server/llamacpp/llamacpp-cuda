ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
ARG BASE_IMAGE=${REGISTRY}/${NAMESPACE}/base:noble

# llamacpp-cuda：CUDA 12.8 开发工具链 + 预编译 llama.cpp
# - 工具链只走 NVIDIA 官方源（cuda-nvcc/cudart-dev/nvrtc-dev/cublas-dev），
#   不要用 Ubuntu 源的 nvidia-cuda-toolkit（12.0 Debian 布局：cicc 不在 PATH、
#   nvcc -v 输出缺行导致 CMake enable_language(CUDA) 失败、
#   -isystem /usr/include 破坏 gcc #include_next、且只支持到 gcc 12）
# - CUDA 必须用 ≤ 12.x：CUDA 13 已移除 Pascal(sm_60/61) 支持，12.8 匹配驱动 580
# - NVIDIA 内核驱动在宿主机，容器经 --gpus all 映射使用 GPU，镜像内不装驱动
FROM ${BASE_IMAGE}

LABEL authors="sarmn"

# CUDA_SERIES       CUDA 版本系列（需宿主机驱动 >= 525）
ARG CUDA_SERIES=12-8
# CUDA_ARCHS        编译的 GPU 架构，必须含 61（P4 为 Pascal/sm_61）
ARG CUDA_ARCHS="61;75;86;89"
# LLAMACPP_VERSION  llama.cpp 版本（GitHub tag，如 v0.4.0）；留空自动解析最新 release
ARG LLAMACPP_VERSION=

# 开发工具链（官方源标准布局 /usr/local/cuda）+ 编译 llama.cpp 所需工具。
# cuda-driver-dev：提供 libcuda.so stub，供无 GPU 的构建机链接/验证；
# libgomp1：llama.cpp 等 OpenMP 程序的运行时依赖
RUN set -eux; \
    install -m 0755 -d /etc/apt/keyrings; \
    curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/3bf863cc.pub \
      | gpg --dearmor -o /etc/apt/keyrings/cuda.gpg; \
    chmod a+r /etc/apt/keyrings/cuda.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/ /" \
      > /etc/apt/sources.list.d/cuda.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      cuda-nvcc-${CUDA_SERIES} \
      cuda-cudart-dev-${CUDA_SERIES} \
      cuda-nvrtc-dev-${CUDA_SERIES} \
      libcublas-dev-${CUDA_SERIES} \
      cuda-driver-dev-${CUDA_SERIES} \
      cmake \
      libcurl4-openssl-dev \
      libgomp1; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# 编译并安装 llama.cpp 到 /deployment/software/llama.cpp（bin/lib/include）
RUN set -eux; \
    export PATH=/usr/local/cuda/bin:$PATH; \
    export CUDACXX=/usr/local/cuda/bin/nvcc; \
    nvcc --version; \
    version="${LLAMACPP_VERSION}"; \
    if [ -z "$version" ]; then \
      version="$(curl -fsSL https://api.github.com/repos/ggml-org/llama.cpp/releases/latest \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"; \
    fi; \
    [ -n "$version" ] || { echo "无法解析 llama.cpp 版本，请用 --build-arg LLAMACPP_VERSION= 指定"; exit 1; }; \
    echo "Building llama.cpp ${version} (archs: ${CUDA_ARCHS})"; \
    cd /tmp; \
    curl -fsSL -o llama.cpp.tar.gz "https://github.com/ggml-org/llama.cpp/archive/refs/tags/${version}.tar.gz"; \
    tar -xzf llama.cpp.tar.gz; \
    srcdir="/tmp/llama.cpp-${version#v}"; \
    # stub 目录只有 libcuda.so，无 GPU 构建机运行产物需要 libcuda.so.1 \
    ln -sf libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1; \
    # GGML_NATIVE=OFF：避免按构建机 CPU 指令集编译导致部署机非法指令 \
    cmake -S "$srcdir" -B "$srcdir/build" \
      -DGGML_CUDA=ON \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHS}" \
      -DGGML_NATIVE=OFF \
      -DLLAMA_BUILD_TESTS=OFF \
      -DLLAMA_BUILD_EXAMPLES=OFF \
      -DCMAKE_BUILD_TYPE=Release; \
    cmake --build "$srcdir/build" -j"$(nproc)"; \
    cmake --install "$srcdir/build" --prefix /deployment/software/llama.cpp; \
    echo /deployment/software/llama.cpp/lib > /etc/ld.so.conf.d/llamacpp.conf; \
    ldconfig; \
    # 无 GPU 构建机：借 stub 验证产物可执行 \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs /deployment/software/llama.cpp/bin/llama-server --version; \
    rm -rf "$srcdir" llama.cpp.tar.gz

ENV PATH=/deployment/software/llama.cpp/bin:$PATH

RUN mkdir -p /deployment/workspace/apps/models

ENTRYPOINT ["/init"]
