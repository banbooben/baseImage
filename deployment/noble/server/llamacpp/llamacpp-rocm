ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
ARG BASE_IMAGE=${REGISTRY}/${NAMESPACE}/base:noble

# llamacpp-rocm：ROCm/HIP 后端 llama.cpp（AMD 6900XT / gfx1030）
# - ROCm 钉 6.3：gfx1030 已不在新版 ROCm 官方支持列表，6.x 源码编译仍可；
#   不要用 ROCm 7（LLVM 目标裁剪风险更大）
# - 运行时宿主机需 amdgpu 内核驱动，容器映射 --device=/dev/kfd --device=/dev/dri，
#   无需 nvidia-container-toolkit 之类的额外组件
FROM ${BASE_IMAGE}

LABEL authors="sarmn"

# ROCM_VERSION      ROCm 源版本（apt repo 目录名）
ARG ROCM_VERSION=6.3
# AMDGPU_TARGETS    编译的 GPU 架构，6900XT 为 gfx1030
ARG AMDGPU_TARGETS=gfx1030
# LLAMACPP_VERSION  llama.cpp 版本（GitHub tag，如 v0.4.0）；留空自动解析最新 release
ARG LLAMACPP_VERSION=

# ROCm 官方源 + HIP 编译链（hipcc + HIP/rocBLAS/hipBLAS 开发包）
RUN set -eux; \
    install -m 0755 -d /etc/apt/keyrings; \
    curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg; \
    chmod a+r /etc/apt/keyrings/rocm.gpg; \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/${ROCM_VERSION} noble main" \
      > /etc/apt/sources.list.d/rocm.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      hipcc \
      rocm-hip-runtime-dev \
      rocblas-dev \
      hipblas-dev \
      cmake \
      libcurl4-openssl-dev \
      libgomp1; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# 编译并安装 llama.cpp 到 /deployment/software/llama.cpp（bin/lib/include）
RUN set -eux; \
    export PATH=/opt/rocm/bin:$PATH; \
    version="${LLAMACPP_VERSION}"; \
    if [ -z "$version" ]; then \
      version="$(curl -fsSL https://api.github.com/repos/ggml-org/llama.cpp/releases/latest \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"; \
    fi; \
    [ -n "$version" ] || { echo "无法解析 llama.cpp 版本，请用 --build-arg LLAMACPP_VERSION= 指定"; exit 1; }; \
    echo "Building llama.cpp ${version} (ROCm ${ROCM_VERSION}, targets: ${AMDGPU_TARGETS})"; \
    cd /tmp; \
    curl -fsSL -o llama.cpp.tar.gz "https://github.com/ggml-org/llama.cpp/archive/refs/tags/${version}.tar.gz"; \
    tar -xzf llama.cpp.tar.gz; \
    srcdir="/tmp/llama.cpp-${version#v}"; \
    # GGML_NATIVE=OFF：避免按构建机 CPU 指令集编译导致部署机非法指令 \
    cmake -S "$srcdir" -B "$srcdir/build" \
      -DGGML_HIP=ON \
      -DAMDGPU_TARGETS="${AMDGPU_TARGETS}" \
      -DGGML_NATIVE=OFF \
      -DLLAMA_BUILD_TESTS=OFF \
      -DLLAMA_BUILD_EXAMPLES=OFF \
      -DCMAKE_BUILD_TYPE=Release; \
    cmake --build "$srcdir/build" -j"$(nproc)"; \
    cmake --install "$srcdir/build" --prefix /deployment/software/llama.cpp; \
    echo /deployment/software/llama.cpp/lib > /etc/ld.so.conf.d/llamacpp.conf; \
    ldconfig; \
    # 无 GPU 构建机：HIP 初始化找不到设备会告警后继续，--version 可正常输出 \
    /deployment/software/llama.cpp/bin/llama-server --version; \
    rm -rf "$srcdir" llama.cpp.tar.gz

ENV PATH=/deployment/software/llama.cpp/bin:/opt/rocm/bin:$PATH

RUN mkdir -p /deployment/workspace/apps/models

ENTRYPOINT ["/init"]
