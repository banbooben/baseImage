ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn

FROM ${REGISTRY}/${NAMESPACE}/software:noble-code-server AS codeserver
FROM ${REGISTRY}/${NAMESPACE}/language:noble-python-3.14 AS py314
FROM ${REGISTRY}/${NAMESPACE}/language:noble-python-3.14-ft AS py314ft
FROM ${REGISTRY}/${NAMESPACE}/language:noble-python-3.13 AS py313
FROM ${REGISTRY}/${NAMESPACE}/language:noble-python-3.13-ft AS py313ft
FROM ${REGISTRY}/${NAMESPACE}/language:noble-python-3.12 AS py312
FROM ${REGISTRY}/${NAMESPACE}/language:noble-python-3.11 AS py311


FROM ${REGISTRY}/${NAMESPACE}/base:noble

LABEL authors="sarmn"

ARG UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}
ENV UV_LINK_MODE=copy


# 统一 ENV（避免分散定义导致 PATH/DISPLAY 互相覆盖）
ENV PATH=/deployment/software/code-server/bin:/deployment/bin:$PATH


COPY --from=py311 /deployment/software/python /deployment/software/python3.11
COPY --from=py312 /deployment/software/python /deployment/software/python3.12
COPY --from=py313 /deployment/software/python /deployment/software/python3.13
COPY --from=py314 /deployment/software/python /deployment/software/python3.14
COPY --from=py313ft /deployment/software/python /deployment/software/python3.13-ft
COPY --from=py314ft /deployment/software/python /deployment/software/python3.14-ft

COPY --from=codeserver /deployment/software/code-server /deployment/software/code-server
COPY --from=codeserver /etc/s6-overlay/s6-rc.d/code-server /etc/s6-overlay/s6-rc.d/code-server
COPY --from=codeserver /etc/s6-overlay/s6-rc.d/user/contents.d/code-server /etc/s6-overlay/s6-rc.d/user/contents.d/code-server

# 启用 sshd（s6-overlay v3 用空文件标记启用）
RUN mkdir -p /deployment/bin /deployment/software/python/bin; \
    : > /etc/s6-overlay/s6-rc.d/user/contents.d/sshd; \
    ln -s /deployment/software/code-server/bin/code-server /deployment/bin/code-server; \
    ln -s /deployment/software/python3.11/bin/python3.11 /deployment/bin/python3.11; \
    ln -s /deployment/software/python3.12/bin/python3.12 /deployment/bin/python3.12; \
    ln -s /deployment/software/python3.13/bin/python3.13 /deployment/bin/python3.13; \
    ln -s /deployment/software/python3.14/bin/python3.14 /deployment/bin/python3.14; \
    ln -s /deployment/software/python3.11/bin/pip3.11 /deployment/bin/pip3.11; \
    ln -s /deployment/software/python3.12/bin/pip3.12 /deployment/bin/pip3.12; \
    ln -s /deployment/software/python3.13/bin/pip3.13 /deployment/bin/pip3.13; \
    ln -s /deployment/software/python3.14/bin/pip3.14 /deployment/bin/pip3.14; \
    ln -s /deployment/software/python3.13-ft/bin/python3.13t /deployment/bin/python3.13t; \
    ln -s /deployment/software/python3.14-ft/bin/python3.14t /deployment/bin/python3.14t; \
    ln -s /deployment/software/python3.13-ft/bin/pip3.13t /deployment/bin/pip3.13t; \
    ln -s /deployment/software/python3.14-ft/bin/pip3.14t /deployment/bin/pip3.14t; \
    ln -sfn /deployment/software/python3.11/bin/python3.11 /deployment/software/python/bin/python3.11; \
    ln -sfn /deployment/software/python3.12/bin/python3.12 /deployment/software/python/bin/python3.12; \
    ln -sfn /deployment/software/python3.13/bin/python3.13 /deployment/software/python/bin/python3.13; \
    ln -sfn /deployment/software/python3.14/bin/python3.14 /deployment/software/python/bin/python3.14; \
    ln -sfn /deployment/software/python3.13-ft/bin/python3.13t /deployment/software/python/bin/python3.13t; \
    ln -sfn /deployment/software/python3.14-ft/bin/python3.14t /deployment/software/python/bin/python3.14t

ENTRYPOINT ["/init"]
