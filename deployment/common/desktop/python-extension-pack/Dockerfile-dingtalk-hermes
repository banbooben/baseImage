# 钉钉数字同事 hermes 版（desktop）—— 在 desktop python-extension-pack 基础上
# 叠加 hermes + dws + dingtalk-bridge 群桥守护进程。
#
# 与 backend 版 software:<os>-dingtalk-hermes 的区别：本镜像把「数字同事」服务装进
# 桌面开发环境（Xfce + code-server + Python + Chrome/DBeaver/WPS/VS Code），
# s6 启动即常驻 hermes gateway，登录态/数据域走卷挂载。
# 安装脚本复用 backend 的 install_dingtalk_hermes.sh；common.sh 已由 base 内置。

ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
ARG OS_TAG=noble
# PYTHON_SERIES 必填（如 3.12）：上游 deployment 镜像 tag 由它派生
ARG PYTHON_SERIES
FROM ${REGISTRY}/${NAMESPACE}/deployment:${OS_TAG}-desktop-python${PYTHON_SERIES}-extension-pack

LABEL authors="sarmn"

ARG DWS_PIN_VERSION
ARG HERMES_PIN_VERSION=v0.22.4
# 同 backend：GitHub 不可达时用 --build-arg HERMES_REPO_URL=<镜像 git URL> 覆盖
ARG HERMES_REPO_URL=""

# 复用 backend 的安装脚本（自举 DWS + Hermes + dingtalk-bridge 群桥 + s6 longrun）
COPY ./images/software/backend/install_dingtalk_hermes.sh /tmp/install_dingtalk_hermes.sh
COPY ./images/software/backend/dingtalk-hermes-plugin /tmp/dingtalk-hermes-plugin
# 固化的上游安装脚本（供应链 pin；同 backend）
COPY ./images/software/backend/vendor /tmp/vendor
# 构建期覆盖基镜像继承的 UV_DEFAULT_INDEX（基镜像指向 tuna 镜像站，uv 拉 wheel/setuptools
# 实测返回 403 导致 hermes 依赖安装失败；backend 构建实测 pypi.org 直连可用）。
# 仅在本 RUN 内生效，不写入最终镜像 ENV（桌面日常 pip/uv 仍走 tuna）。
RUN set -eux; \
    UV_DEFAULT_INDEX=https://pypi.org/simple /bin/bash /tmp/install_dingtalk_hermes.sh

# 不设 HERMES_HOME / DWS_CONFIG_DIR：全部走运行用户 home 默认路径
# （~/.hermes、~/.dws、~/.agents、~/.local/...），持久化由 compose 按目录挂卷。

ENTRYPOINT ["/init"]
