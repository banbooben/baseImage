# 钉钉数字同事（desktop 版）—— 在 desktop python-extension-pack 基础上叠加 dingtalk-dsh
#
# 与 backend 版 software:<os>-dingtalk-dsh 的区别：本镜像把「数字同事」服务装进
# 桌面开发环境（Xfce + code-server + Python 3.14 + Chrome/DBeaver/WPS/VS Code），
# s6 启动即常驻 dsh web（127.0.0.1:3080），登录态/数据域走卷挂载。
# 安装脚本复用 backend 的 install_dingtalk_dsh.sh；common.sh 已由 base 内置。

ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
ARG OS_TAG=noble
FROM ${REGISTRY}/${NAMESPACE}/deployment:${OS_TAG}-desktop-python3.14-extension-pack

LABEL authors="sarmn"

ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG DWS_PIN_VERSION
ARG DSH_PIN_VERSION=0.1.2-rc.1

# 复用 backend 的安装脚本（自举 Node 24 + DWS + DSH + 钉钉插件 + s6 longrun）
COPY ./images/software/backend/install_dingtalk_dsh.sh /tmp/install_dingtalk_dsh.sh
RUN set -eux; \
    /bin/bash /tmp/install_dingtalk_dsh.sh

# 数据域/登录态默认值（运行期可用卷挂载覆盖，实现按实例隔离）
ENV DSH_HOME=/deployment/software/dingtalk-dsh/home \
    DWS_CONFIG_DIR=/deployment/software/dingtalk-dsh/dws-config

ENTRYPOINT ["/init"]
