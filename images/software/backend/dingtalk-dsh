# 钉钉数字同事（DingTalk digital colleague）—— backend 软件镜像
#
# FROM base:<os_tag>（s6-overlay），安装脚本自举 Node 24 + DWS + DSH + 钉钉插件。
# 运行期常驻 dsh web（127.0.0.1:3080）；登录态 / 数据域走卷挂载，见 install 脚本 README。

ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
ARG OS_TAG=noble
ARG BASE_IMAGE=${REGISTRY}/${NAMESPACE}/base:${OS_TAG}
FROM ${BASE_IMAGE}

LABEL authors="sarmn"

ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG DWS_PIN_VERSION
ARG DSH_PIN_VERSION=0.1.2-rc.1

COPY ./images/common.sh /deployment/scripts/common.sh
COPY ./images/software/backend/install_dingtalk_dsh.sh /tmp/install_dingtalk_dsh.sh

RUN set -eux; \
    /bin/bash /tmp/install_dingtalk_dsh.sh; \
    echo 'source /deployment/scripts/common.sh' >> /etc/bash.bashrc

ENV DSH_HOME=/deployment/software/dingtalk-dsh/home \
    DWS_CONFIG_DIR=/deployment/software/dingtalk-dsh/dws-config \
    PATH=/deployment/bin:/usr/local/lib/nodejs/bin:$PATH

EXPOSE 3080

ENTRYPOINT ["/init"]
