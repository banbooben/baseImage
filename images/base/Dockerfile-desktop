ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
# 见 Dockerfile 中同名参数的说明
ARG OS_TAG=noble
ARG BASE_IMAGE=${REGISTRY}/${NAMESPACE}/base:${OS_TAG}
FROM ${BASE_IMAGE}

LABEL authors="sarmn"

ENV PATH=/deployment/bin:$PATH \
    LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    LC_ALL=zh_CN.UTF-8 \
    DISPLAY=:1

COPY ./images/common.sh /deployment/scripts/common.sh
COPY ./images/base/install_desktop.sh /tmp/install_desktop.sh
# 构建期断言：桌面包必须真的装上。脚本已让 apt 失败向上传递，这里再兜一层——
# 任何原因（源不可达、包名漂移）导致组件缺失都让构建失败，而不是像 2026-11-23
# 那次一样推出一份"有 VNC 服务、没有桌面"的镜像。
RUN set -eux; \
    /bin/bash /tmp/install_desktop.sh; \
    command -v startxfce4; \
    command -v Xvnc; \
    command -v websockify; \
    echo 'source /deployment/scripts/common.sh' >> /etc/bash.bashrc

ENTRYPOINT ["/init"]
