ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
FROM ${REGISTRY}/${NAMESPACE}/base:noble as builder

ARG JAVA_PIN_VERSION

COPY ./docker_installer/installer/common.sh /deployment/scripts/common.sh
COPY ./docker_installer/installer/languages/java/install_openjdk_24.sh /tmp/install_java.sh
RUN /bin/bash /tmp/install_java.sh

FROM ${REGISTRY}/${NAMESPACE}/base:noble
LABEL authors="sarmn"

COPY --from=builder /deployment/openjdk /deployment/openjdk
COPY --from=builder /etc/cont-env.d/JAVA_VERSION /etc/cont-env.d/JAVA_VERSION
COPY --from=builder /etc/cont-env.d/OPENJDK_VERSION /etc/cont-env.d/OPENJDK_VERSION
COPY --from=builder /etc/environment /etc/environments/env-java
ENV PATH=/deployment/openjdk/bin:$PATH \
    JAVA_HOME=/deployment/openjdk \
    JAVA_VERSION=24
RUN /bin/bash -c "source /deployment/scripts/common.sh && merge_and_save_env"

ENTRYPOINT ["/init"]
CMD ["jshell"]
