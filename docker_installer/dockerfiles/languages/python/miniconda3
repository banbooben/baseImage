ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
# OS_TAG     产物标签后缀：base:<OS_TAG> / language:<OS_TAG>-python-3.12 …
# BASE_IMAGE 上游 base 镜像（桌面链为 base:<OS_TAG>-desktop）。Ubuntu 与 openEuler
#            的差异只在这里，安装脚本靠 /etc/os-release 自行分派（见 installer/common.sh）
ARG OS_TAG=noble
ARG BASE_IMAGE=${REGISTRY}/${NAMESPACE}/base:${OS_TAG}
FROM ${BASE_IMAGE} as builder

COPY ./docker_installer/installer/languages/python/install_miniconda.sh /tmp/install_miniconda.sh
RUN /bin/bash /tmp/install_miniconda.sh

FROM ${BASE_IMAGE}
LABEL authors="sarmn"

COPY --from=builder /deployment/miniconda /deployment/miniconda
COPY --from=builder /etc/cont-env.d/MINICONDA_VERSION /etc/cont-env.d/MINICONDA_VERSION
COPY --from=builder /etc/environment /etc/environments/env-miniconda
ENV PATH="/deployment/miniconda/bin:$PATH"

RUN /bin/bash -c "source /deployment/scripts/common.sh && merge_and_save_env"

ENTRYPOINT ["/init"]
CMD tail -f /dev/null
