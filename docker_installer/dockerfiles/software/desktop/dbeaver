ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
# OS_TAG     产物标签后缀：base:<OS_TAG> / language:<OS_TAG>-python-3.12 …
# BASE_IMAGE 上游 base 镜像（桌面链为 base:<OS_TAG>-desktop）。Ubuntu 与 openEuler
#            的差异只在这里，安装脚本靠 /etc/os-release 自行分派（见 installer/common.sh）
ARG OS_TAG=noble
ARG BASE_IMAGE=${REGISTRY}/${NAMESPACE}/base:${OS_TAG}-desktop
FROM ${BASE_IMAGE}

LABEL authors="sarmn"

ARG DBEAVER_PIN_VERSION
ARG MYSQL_JDBC_VERSION
ARG MARIADB_JDBC_VERSION
ARG POSTGRES_JDBC_VERSION
ARG ORACLE_JDBC_VERSION
ARG MSSQL_JDBC_VERSION
ARG SQLITE_JDBC_VERSION
ARG DAMENG_JDBC_VERSION
ARG DAMENG_JDBC_URL
ARG MAVEN_CENTRAL_PRIMARY
ARG MAVEN_CENTRAL_FALLBACK

COPY ./docker_installer/installer/common.sh /deployment/scripts/common.sh
COPY ./docker_installer/installer/software/desktop/install_dbeaver.sh /tmp/install_dbeaver.sh
RUN set -eux; \
    /bin/bash /tmp/install_dbeaver.sh; \
    echo 'source /deployment/scripts/common.sh' >> /etc/bash.bashrc

ENV DBEAVER_HOME=/deployment/software/dbeaver \
    DBEAVER_DRIVERS=/deployment/software/dbeaver/drivers \
    DBEAVER_DATA=/deployment/software/dbeaver/data \
    DISPLAY=:1 \
    PATH=/deployment/software/dbeaver:/deployment/bin:$PATH

ENTRYPOINT ["/init"]
