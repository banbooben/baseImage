ARG REGISTRY=registry.cn-hangzhou.aliyuncs.com
ARG NAMESPACE=sarmn
ARG BASE_IMAGE=${REGISTRY}/${NAMESPACE}/base:noble-desktop
FROM ${BASE_IMAGE}

LABEL authors="sarmn"

ARG WPS_PIN_VERSION
ARG WPS_DEB_URL

COPY ./docker_installer/installer/common.sh /deployment/scripts/common.sh
COPY ./docker_installer/installer/software/desktop/install_wps.sh /tmp/install_wps.sh
RUN set -eux; \
    /bin/bash /tmp/install_wps.sh; \
    echo 'source /deployment/scripts/common.sh' >> /etc/bash.bashrc

ENV WPS_HOME=/deployment/software/wps \
    DISPLAY=:1 \
    PATH=/deployment/bin:$PATH

ENTRYPOINT ["/init"]
